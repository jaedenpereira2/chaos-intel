{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chaos-intel.io/schemas/finding.schema.json",
  "title": "Finding",
  "description": "Schema definition for an identified vulnerability or resilience failure",
  "type": "object",
  "required": [
    "id",
    "projectId",
    "applicationId",
    "serviceId",
    "severity",
    "category",
    "title",
    "status",
    "observedBehavior",
    "probableRootCause",
    "confidence",
    "impact",
    "recovery",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "applicationId": {
      "type": "string",
      "format": "uuid"
    },
    "serviceId": {
      "type": "string",
      "format": "uuid"
    },
    "serviceName": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
    },
    "category": {
      "type": "string",
      "enum": [
        "CASCADING_FAILURE",
        "CIRCUIT_BREAKER_MISSING",
        "TIMEOUT_MISCONFIGURATION",
        "UNHANDLED_EXCEPTION",
        "DATA_CORRUPTION_RISK",
        "RESOURCE_EXHAUSTION",
        "ASYNC_RETRY_STORM",
        "DEGRADED_STATE_LEAK"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["OPEN", "INVESTIGATING", "RESOLVED", "IGNORED"]
    },
    "observedBehavior": {
      "type": "string",
      "description": "Detailed description of what occurred during failure"
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "description"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "description": { "type": "string" },
          "stage": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "probableRootCause": {
      "type": "string",
      "description": "P3 RCA engine deduction of why the system failed"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "AI / rule engine confidence score (0.0 to 1.0)"
    },
    "impact": {
      "type": "string",
      "description": "Description of blast radius and user impact"
    },
    "recovery": {
      "type": "string",
      "description": "Observed system recovery time and steps"
    },
    "recommendationId": {
      "type": "string",
      "format": "uuid"
    },
    "experimentRunId": {
      "type": "string",
      "format": "uuid"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "title", "url"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "type": { "type": "string", "enum": ["SCREENSHOT", "LOG", "METRIC", "TRACE"] },
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "details": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}

