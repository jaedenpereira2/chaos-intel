{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chaos-intel.io/schemas/service.schema.json",
  "title": "Service",
  "description": "Schema definition for a service node discovered or registered within an application",
  "type": "object",
  "required": ["id", "applicationId", "name", "nodeType", "status", "createdAt", "updatedAt"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique UUID for the service"
    },
    "applicationId": {
      "type": "string",
      "format": "uuid",
      "description": "UUID of the owning application"
    },
    "name": {
      "type": "string",
      "description": "Service name / identifier"
    },
    "nodeType": {
      "type": "string",
      "enum": ["frontend", "service", "database", "cache", "queue", "external dependency"],
      "description": "Canonical node type provided by P1"
    },
    "status": {
      "type": "string",
      "enum": ["HEALTHY", "DEGRADED", "UNHEALTHY", "UNKNOWN"]
    },
    "version": {
      "type": "string"
    },
    "port": {
      "type": "integer"
    },
    "protocol": {
      "type": "string"
    },
    "healthEndpoint": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["targetServiceId", "dependencyType"],
        "properties": {
          "targetServiceId": {
            "type": "string",
            "format": "uuid"
          },
          "dependencyType": {
            "type": "string",
            "enum": ["HTTP", "gRPC", "TCP", "AMQP", "DATABASE_CLIENT", "CACHE_CLIENT", "EXTERNAL_API"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Confidence of discovered dependency (0.0 - 1.0)"
          }
        },
        "additionalProperties": false
      }
    },
    "recentFailuresCount": {
      "type": "integer",
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}

